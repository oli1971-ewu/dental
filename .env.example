# PostgreSQL Database Connection (Option A: Full connection string for Neon / Supabase / Railway on Netlify)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# PostgreSQL Database Connection (Option B: Individual variables)
SQL_HOST="your-db-host"
SQL_PORT="5432"
SQL_USER="your-db-user"
SQL_PASSWORD="your-db-password"
SQL_DB_NAME="your-db-name"

# Authentication Secret
JWT_SECRET="replace-with-a-strong-random-secret"
